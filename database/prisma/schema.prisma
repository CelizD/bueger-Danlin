generator client {
  provider     = "prisma-client"
  output       = "../../apps/api/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  KITCHEN
  DELIVERY
}

enum ProductType {
  COMBO
  BEVERAGE
  ADD_ON
}

enum ModifierKind {
  REMOVABLE
  EXTRA
  ADD_ON
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
  REFUNDED
  NO_SHOW
}

enum PaymentProvider {
  MOCK
  STRIPE
  MERCADOPAGO
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentWebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

enum EmailNotificationType {
  PURCHASE_CONFIRMATION
}

enum EmailNotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum PickupEventStatus {
  DRAFT
  OPEN
  SOLD_OUT
  CLOSED
  COMPLETED
  CANCELLED
}

enum InventoryAllocationStatus {
  RESERVED
  COMMITTED
  RELEASED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role                UserRole @default(ADMIN)
  active              Boolean  @default(true)
  failedLoginAttempts    Int      @default(0)
  lockedUntil            DateTime?
  lastLoginAt            DateTime?
  mfaEnabled             Boolean  @default(false)
  mfaSecretEncrypted     String?
  mfaRecoveryCodeHashes  Json?
  mfaLastUsedStep        Int?
  mfaEnrolledAt          DateTime?
  createdAt              DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs     AuditLog[]
  staffSessions StaffSession[]

  @@index([lockedUntil])
}

model StaffSession {
  id                String   @id
  userId            String
  credentialVersion String
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([phone])
  @@index([email])
}

model Product {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  description   String?
  type          ProductType
  priceCents    Int
  active        Boolean     @default(true)
  trackStock    Boolean     @default(false)
  stockQuantity Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  modifierGroups ProductModifierGroup[]
  orderItems     OrderItem[]
  inventoryUsages InventoryUsage[]
}

model ModifierGroup {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  minSelect   Int      @default(0)
  maxSelect   Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  options  ModifierOption[]
  products ProductModifierGroup[]
}

model ModifierOption {
  id              String       @id @default(cuid())
  key             String       @unique
  groupId         String
  name            String
  kind            ModifierKind
  priceDeltaCents Int          @default(0)
  defaultSelected Boolean      @default(false)
  active          Boolean      @default(true)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  group           ModifierGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItems      OrderItemModifier[]
  inventoryUsages InventoryUsage[]

  @@index([groupId, sortOrder])
}

model ProductModifierGroup {
  productId       String
  modifierGroupId String
  sortOrder       Int    @default(0)

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([productId, modifierGroupId])
}

model PickupPoint {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  latitude  Float?
  longitude Float?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events PickupEvent[]

  @@index([active, name])
}

model PickupEvent {
  id                        String            @id @default(cuid())
  code                      String            @unique
  name                      String
  locationLabel             String
  pickupPointId             String
  timezone                  String            @default("America/Tijuana")
  startsAt                  DateTime
  closesAt                  DateTime
  maxCombos                 Int               @default(50)
  freeDeliveryMinPaidCombos              Int               @default(5)
  transportCostCents                     Int               @default(0)
  groupDeliveryFinalizedAt               DateTime?
  groupDeliveryFinalPaidCombos           Int?
  groupDeliveryFinalTransportCostCents   Int?
  groupDeliveryFinalAssignedCents        Int?
  groupDeliveryFinalFreeUnlocked         Boolean?
  groupDeliveryFinalCancelledPendingOrders Int?
  telegramGroupCompletedAt               DateTime?
  telegramGroupCompletedPaidCombos       Int?
  telegramGroupCompletedNotificationClaimedAt DateTime?
  telegramGroupCompletedNotifiedAt       DateTime?
  telegramGroupClosedNotificationClaimedAt DateTime?
  telegramGroupClosedNotifiedAt          DateTime?
  status                                 PickupEventStatus @default(DRAFT)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  pickupPoint PickupPoint @relation(fields: [pickupPointId], references: [id], onDelete: Restrict)
  orders      Order[]

  @@index([pickupPointId, startsAt])
  @@index([startsAt])
  @@index([status, closesAt])
  @@index([groupDeliveryFinalizedAt, closesAt])
}

model Order {
  id                    String        @id @default(cuid())
  orderCode             String        @unique
  requestKey            String        @unique
  requestHash           String
  customerId            String
  pickupEventId         String
  status                OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus         PaymentStatus @default(PENDING)
  currency              String        @default("MXN")
  subtotalCents         Int
  totalCents            Int
  comboQuantity         Int
  verificationTokenHash String        @unique
  reservationExpiresAt                    DateTime?
  cancelledAt                             DateTime?
  deliveredAt                             DateTime?
  purchaseTermsAcceptedAt                 DateTime?
  purchaseTermsVersion                    String?
  groupDeliveryTermsAcceptedAt            DateTime?
  groupDeliveryTermsVersion               String?
  groupDeliveryMinPaidCombosAtOrder       Int?
  groupDeliveryTransportCostCentsAtOrder  Int?
  groupDeliveryPaidCombosAtOrder          Int?
  groupDeliveryEstimatedFeeCentsAtOrder   Int?
  groupDeliveryFinalFeeCents               Int?
  groupDeliveryFinalizedAt                 DateTime?
  groupDeliveryFeeCollectedAt              DateTime?
  groupDeliveryFeeCollectedCents           Int?
  createdAt                                DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  customer      Customer            @relation(fields: [customerId], references: [id])
  pickupEvent   PickupEvent         @relation(fields: [pickupEventId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  statusHistory       OrderStatusHistory[]
  inventoryAllocations InventoryAllocation[]
  emailNotifications EmailNotification[]

  @@index([pickupEventId, status])
  @@index([pickupEventId, reservationExpiresAt])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  unitPriceCents Int
  quantity       Int    @default(1)
  lineTotalCents Int

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id])
  modifiers OrderItemModifier[]

  @@index([orderId])
}

model OrderItemModifier {
  id               String  @id @default(cuid())
  orderItemId      String
  modifierOptionId String
  optionName       String
  priceDeltaCents  Int
  quantity         Int     @default(1)
  removed          Boolean @default(false)

  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id])

  @@index([orderItemId])
}

model Payment {
  id             String          @id @default(cuid())
  orderId        String
  provider       PaymentProvider
  status         PaymentStatus   @default(PENDING)
  amountCents    Int
  currency       String          @default("MXN")
  externalId     String?
  idempotencyKey String          @unique
  metadata       Json?
  paidAt         DateTime?
  refundedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([provider, externalId])
}

model PaymentWebhookEvent {
  id            String                    @id @default(cuid())
  provider      PaymentProvider
  eventId       String
  replayKey     String
  resourceId    String
  requestId     String?
  type          String
  bodyHash      String
  status        PaymentWebhookEventStatus @default(RECEIVED)
  attemptCount  Int                       @default(0)
  lastError     String?
  receivedAt    DateTime                  @default(now())
  processedAt   DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@unique([provider, eventId])
  @@unique([provider, replayKey])
  @@index([provider, resourceId])
  @@index([status, receivedAt])
}

model OrderStatusHistory {
  id        String       @id @default(cuid())
  orderId   String
  from      OrderStatus?
  to        OrderStatus
  note      String?
  createdAt DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}


model InventoryItem {
  id                String   @id @default(cuid())
  key               String   @unique
  name              String
  unit              String
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(5)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  usages      InventoryUsage[]
  allocations InventoryAllocation[]
}

model InventoryUsage {
  id               String @id @default(cuid())
  key              String @unique
  inventoryItemId  String
  productId        String
  modifierOptionId String?
  quantity         Int    @default(1)

  inventoryItem  InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierOption ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([productId])
  @@index([modifierOptionId])
}

model InventoryAllocation {
  id              String                    @id @default(cuid())
  orderId         String
  inventoryItemId String
  quantity        Int
  status          InventoryAllocationStatus @default(RESERVED)
  releasedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([orderId, inventoryItemId])
  @@index([inventoryItemId, status])
  @@index([status, createdAt])
}

model EmailNotification {
  id           String                  @id @default(cuid())
  orderId      String
  type         EmailNotificationType
  recipient    String
  status       EmailNotificationStatus @default(PENDING)
  attemptCount Int                     @default(0)
  claimedAt    DateTime?
  sentAt       DateTime?
  lastError    String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@index([status, createdAt])
  @@index([claimedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
