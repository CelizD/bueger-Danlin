logging {
  level  = "info"
  format = "logfmt"
}

loki.source.file "docker_logs" {
  targets = [
    {
      "__path__" = "/var/lib/docker/containers/*/*-json.log",
      "job"      = "docker",
    },
  ]

  forward_to    = [loki.process.docker_logs.receiver]
  tail_from_end = true

  file_match {
    enabled     = true
    sync_period = "5s"
  }
}

loki.process "docker_logs" {
  stage.json {
    expressions = {
      attrs = "",
    }
  }

  stage.docker {}

  stage.json {
    expressions = {
      container = "tag",
    }
    source = "attrs"
  }

  stage.labels {
    values = {
      container = "",
    }
  }

  stage.decolorize {}

  stage.drop {
    longer_than         = "256KB"
    drop_counter_reason = "oversized_log_line"
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "api_traces" {
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}

otelcol.processor.batch "traces" {
  timeout             = "1s"
  send_batch_size     = 256
  send_batch_max_size = 512

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}
