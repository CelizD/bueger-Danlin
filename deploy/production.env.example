# Copia este archivo fuera del repositorio, por ejemplo:
# /etc/burger-danlin/production.env
#
# chmod 600 /etc/burger-danlin/production.env
#
# Production secrets are not stored directly in this file. An external
# secret backend must materialize the application secrets referenced by
# the *_FILE settings below before go-live.
SECRETS_BACKEND=unconfigured

APP_TIMEZONE=America/Tijuana
APP_ORIGIN=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

# Aviso de privacidad. Usa la identidad legal real del responsable,
# un domicilio de contacto y un correo atendido para privacidad/ARCO.
PRIVACY_RESPONSIBLE=
PRIVACY_ADDRESS=
PRIVACY_EMAIL=

# Datos públicos del proveedor. Deben ser los datos reales que verá el cliente.
BUSINESS_LEGAL_NAME=
BUSINESS_TRADE_NAME=Burger Danlin
BUSINESS_RFC=
BUSINESS_ADDRESS=
SUPPORT_PHONE=
SUPPORT_EMAIL=

# Confirmación de compra por correo. Mantén false hasta configurar y probar SMTP.
# Para producción usa TLS implícito (tls, normalmente 465) o STARTTLS (starttls, normalmente 587).
EMAIL_NOTIFICATIONS_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURITY=starttls
MAIL_USERNAME=
MAIL_PASSWORD_FILE=/etc/burger-danlin/app-secrets/mail-password
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_REJECT_UNAUTHORIZED=true

POSTGRES_DB=burger_danlin

# Administrative database identity. Used only by PostgreSQL bootstrap,
# Prisma migrations and backups. The API must never receive this password.
POSTGRES_ADMIN_USER=burger_admin
POSTGRES_ADMIN_PASSWORD=GENERATE_A_LONG_RANDOM_ADMIN_PASSWORD

# Least-privilege application identity. Used only by the API.
POSTGRES_RUNTIME_USER=burger_runtime
POSTGRES_RUNTIME_PASSWORD=GENERATE_A_DIFFERENT_LONG_RANDOM_RUNTIME_PASSWORD

REDIS_PASSWORD=GENERATE_ANOTHER_LONG_RANDOM_PASSWORD

# MVP production provider: Mercado Pago.
# Stripe remains reserved for a future integration; "mock" is development/test only.
PAYMENT_PROVIDER=mercadopago
# Kill switch: keep false while configuring the VPS. Set true only after sandbox,
# webhook, reconciliation, failure and refund tests pass. go-live-check requires true.
ENABLE_REAL_PAYMENTS=false
MERCADOPAGO_ACCESS_TOKEN_FILE=/etc/burger-danlin/app-secrets/mercadopago-access-token
# Configura en Mercado Pago:
# https://TU_API/api/v1/payments/webhooks/mercadopago
MERCADOPAGO_WEBHOOK_SECRET_FILE=/etc/burger-danlin/app-secrets/mercadopago-webhook-secret

# Application runtime secrets. The files should be materialized by Vault,
# a cloud Secret Manager/KMS-backed process, or an equivalent external backend.
DATABASE_URL_FILE=/etc/burger-danlin/app-secrets/database-url
QR_TOKEN_SECRET_FILE=/etc/burger-danlin/app-secrets/qr-token-secret
AUTH_JWT_SECRET_FILE=/etc/burger-danlin/app-secrets/auth-jwt-secret
MFA_ENCRYPTION_KEY_FILE=/etc/burger-danlin/app-secrets/mfa-encryption-key

# age recipient is PUBLIC and may be stored in deployment config.
# Keep the corresponding private identity outside Git and outside this env file.
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT
BACKUP_AGE_IDENTITY_FILE=/etc/burger-danlin/backup-age.key
BACKUP_DIR=/var/backups/burger-danlin
BACKUP_RETENTION_DAYS=7
BACKUP_PREFIX=burger-danlin

# Offsite immutable backup — IONOS Object Storage / S3-compatible.
# Leave false until an external bucket is configured and verified.
OFFSITE_BACKUP_ENABLED=false

# Create a dedicated bucket with Versioning + Object Lock enabled at creation time.
# Keep these credentials outside Git and give them only the minimum bucket permissions required.
S3_ENDPOINT_URL=https://s3.REPLACE_REGION.ionoscloud.com
S3_REGION=REPLACE_REGION
S3_BUCKET=REPLACE_WITH_DEDICATED_BACKUP_BUCKET
S3_PREFIX=burger-danlin/postgres
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# Data retention cleanup. Keep false until the policy has been reviewed for the
# production jurisdiction. The scheduled job refuses destructive changes unless true.
RETENTION_CLEANUP_ENABLED=false
RETENTION_BATCH_SIZE=200


# Observability. Grafana is bound to 127.0.0.1:3001 by default.
# Generate a long, unique password before enabling the observability profile.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GENERATE_A_LONG_RANDOM_GRAFANA_PASSWORD

# Distributed tracing (OpenTelemetry-compatible OTLP -> Alloy -> Tempo).
# Keep disabled until the observability profile is running and validated.
OTEL_TRACING_ENABLED=false
OTEL_SERVICE_NAME=burger-danlin-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://alloy:4318/v1/traces
OTEL_TRACE_SAMPLE_RATIO=1
# Only internal hosts listed here receive a propagated traceparent header.
# External providers such as Mercado Pago are intentionally excluded by default.
OTEL_PROPAGATE_HOSTS=


# Telegram — business notifications from the API.
# Keep disabled until BotFather token and target chat are verified.
TELEGRAM_NOTIFICATIONS_ENABLED=false
# Do not put the bot token directly in this env file in production.
# Keep the numeric chat ID in the root-only file below.
TELEGRAM_NOTIFY_NEW_ORDER=true
TELEGRAM_NOTIFY_PAYMENT=true
TELEGRAM_NOTIFY_PREPARING=false
TELEGRAM_NOTIFY_READY=true
TELEGRAM_NOTIFY_DELIVERED=true
TELEGRAM_NOTIFY_CANCELLED=true
TELEGRAM_NOTIFY_GROUP_COMPLETED=true
TELEGRAM_NOTIFY_GROUP_CLOSED=true

# Alertmanager reads the same Telegram credentials from root-only files.
TELEGRAM_BOT_TOKEN_FILE=/etc/burger-danlin/telegram-bot-token
TELEGRAM_CHAT_ID_FILE=/etc/burger-danlin/telegram-chat-id
