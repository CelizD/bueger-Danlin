# Copia este archivo fuera del repositorio, por ejemplo:
# /etc/burger-danlin/production.env
#
# chmod 600 /etc/burger-danlin/production.env

APP_TIMEZONE=America/Tijuana
APP_ORIGIN=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

POSTGRES_DB=burger_danlin

# Administrative database identity. Used only by PostgreSQL bootstrap,
# Prisma migrations and backups. The API must never receive this password.
POSTGRES_ADMIN_USER=burger_admin
POSTGRES_ADMIN_PASSWORD=GENERATE_A_LONG_RANDOM_ADMIN_PASSWORD

# Least-privilege application identity. Used only by the API.
POSTGRES_RUNTIME_USER=burger_runtime
POSTGRES_RUNTIME_PASSWORD=GENERATE_A_DIFFERENT_LONG_RANDOM_RUNTIME_PASSWORD

REDIS_PASSWORD=GENERATE_ANOTHER_LONG_RANDOM_PASSWORD

# Production only accepts: stripe or mercadopago.
# Replace this placeholder before deployment. "mock" is development/test only.
PAYMENT_PROVIDER=REPLACE_WITH_stripe_OR_mercadopago
# Kill switch: keep false until sandbox, webhooks, reconciliation and refund flows are fully validated.
ENABLE_REAL_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

QR_TOKEN_SECRET=GENERATE_48_OR_MORE_RANDOM_CHARACTERS
AUTH_JWT_SECRET=GENERATE_A_DIFFERENT_48_OR_MORE_RANDOM_SECRET
MFA_ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_AS_BASE64URL

# age recipient is PUBLIC and may be stored in deployment config.
# Keep the corresponding private identity outside Git and outside this env file.
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT
BACKUP_AGE_IDENTITY_FILE=/etc/burger-danlin/backup-age.key
BACKUP_DIR=/var/backups/burger-danlin
BACKUP_RETENTION_DAYS=7
BACKUP_PREFIX=burger-danlin

# Offsite immutable backup — IONOS Object Storage / S3-compatible.
# Leave false until an external bucket is configured and verified.
OFFSITE_BACKUP_ENABLED=false

# Create a dedicated bucket with Versioning + Object Lock enabled at creation time.
# Keep these credentials outside Git and give them only the minimum bucket permissions required.
S3_ENDPOINT_URL=https://s3.REPLACE_REGION.ionoscloud.com
S3_REGION=REPLACE_REGION
S3_BUCKET=REPLACE_WITH_DEDICATED_BACKUP_BUCKET
S3_PREFIX=burger-danlin/postgres
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# Data retention cleanup. Keep false until the policy has been reviewed for the
# production jurisdiction. The scheduled job refuses destructive changes unless true.
RETENTION_CLEANUP_ENABLED=false
RETENTION_BATCH_SIZE=200


# Observability. Grafana is bound to 127.0.0.1:3001 by default.
# Generate a long, unique password before enabling the observability profile.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GENERATE_A_LONG_RANDOM_GRAFANA_PASSWORD
