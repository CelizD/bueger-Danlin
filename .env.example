NODE_ENV=development
API_PORT=4000
API_PREFIX=api/v1
APP_TIMEZONE=America/Tijuana
APP_ORIGIN=http://localhost:3000
PRIVACY_RESPONSIBLE=Burger Danlin
PRIVACY_ADDRESS=
PRIVACY_EMAIL=

# Datos públicos del vendedor y soporte.
BUSINESS_LEGAL_NAME=
BUSINESS_TRADE_NAME=Burger Danlin
BUSINESS_RFC=
BUSINESS_ADDRESS=
SUPPORT_PHONE=
SUPPORT_EMAIL=

FORCE_HTTPS=false
ENABLE_API_DOCS=true
JSON_BODY_LIMIT=256kb
URLENCODED_BODY_LIMIT=64kb

DATABASE_URL=postgresql://burger:burger_local@localhost:5432/burger_danlin?schema=public
POSTGRES_DB=burger_danlin
POSTGRES_USER=burger
POSTGRES_PASSWORD=burger_local

REDIS_URL=redis://localhost:6379
EMAIL_NOTIFICATIONS_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURITY=none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Burger Danlin <no-reply@burger-danlin.local>
MAIL_REPLY_TO=
MAIL_REJECT_UNAUTHORIZED=true

PAYMENT_PROVIDER=mock
ENABLE_REAL_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
QR_TOKEN_SECRET=change-me-in-production

AUTH_JWT_SECRET=
MFA_ENCRYPTION_KEY=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Administrador


# Telegram notifications (optional in local development)
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_NEW_ORDER=true
TELEGRAM_NOTIFY_PAYMENT=true
TELEGRAM_NOTIFY_PREPARING=false
TELEGRAM_NOTIFY_READY=true
TELEGRAM_NOTIFY_DELIVERED=true
