NODE_ENV=development
API_PORT=4000
API_PREFIX=api/v1
APP_TIMEZONE=America/Tijuana
APP_ORIGIN=http://localhost:3000
PRIVACY_RESPONSIBLE=Burger Danlin
PRIVACY_ADDRESS=
PRIVACY_EMAIL=
FORCE_HTTPS=false
ENABLE_API_DOCS=true
JSON_BODY_LIMIT=256kb
URLENCODED_BODY_LIMIT=64kb

