POSTGRES_DB=burger_danlin
POSTGRES_USER=burger
POSTGRES_PASSWORD=burger_local

REDIS_URL=redis://localhost:6379
MAIL_HOST=localhost
MAIL_PORT=1025

PAYMENT_PROVIDER=mock
ENABLE_REAL_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
QR_TOKEN_SECRET=change-me-in-production

AUTH_JWT_SECRET=
MFA_ENCRYPTION_KEY=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Administrador


# Telegram notifications (optional in local development)
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_NEW_ORDER=true
TELEGRAM_NOTIFY_PAYMENT=true
